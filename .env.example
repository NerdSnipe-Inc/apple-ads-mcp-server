# Apple Ads Platform API credentials (placeholders only - never commit real values)
# Create them in Apple Ads > Account Settings > API (see README).
APPLE_ADS_CLIENT_ID=SEARCHADS.00000000-0000-0000-0000-000000000000
APPLE_ADS_TEAM_ID=SEARCHADS.00000000-0000-0000-0000-000000000000
APPLE_ADS_KEY_ID=00000000-0000-0000-0000-000000000000
# Path to the EC (prime256v1) private key; "~" is expanded.
APPLE_ADS_PRIVATE_KEY_PATH=~/.appleads/private_keys/private-key.pem
# Alternative to the path: the PEM contents inline (use \n for newlines).
# APPLE_ADS_PRIVATE_KEY=

# Optional defaults
# Default ad account ID sent as X-AP-Context: adAccountId=<id>
# APPLE_ADS_AD_ACCOUNT_ID=
# Default org ID for org-level calls (also used to resolve the ad account)
# APPLE_ADS_ORG_ID=

# Safety switches
# APPLE_ADS_READ_ONLY=true
# APPLE_ADS_ENABLED_GROUPS=accounts,campaigns,reports_apps
# APPLE_ADS_DISABLED_GROUPS=budget_orders
